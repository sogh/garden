---
import { getBacklinks } from '../lib/backlinks';
import { withBase, entryPath } from '../lib/site';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const backlinks = await getBacklinks(slug);
---

{backlinks.length > 0 && (
  <section class="backlinks">
    <h2>linked from</h2>
    <ul>
      {backlinks.map(b => (
        <li>
          <a
            href={withBase(entryPath(b.collection, b.id))}
            class="backlink-title"
          >
            {b.title}
          </a>
          {b.excerpt && <div class="backlink-excerpt">{b.excerpt}</div>}
        </li>
      ))}
    </ul>
  </section>
)}
