---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="colophon" narrow>
  <h1>colophon</h1>
  <ul>
    <li>Built with <a href="https://astro.build">Astro</a>, deployed static.</li>
    <li>Body type: <em>Newsreader</em> by Production Type.</li>
    <li>Monospace: <em>JetBrains Mono</em>.</li>
    <li>Code highlighting via Shiki, rose-pine-dawn theme.</li>
    <li>Wiki-links via <code>remark-wiki-link</code>.</li>
    <li>No analytics. No tracking. No cookies.</li>
  </ul>
</BaseLayout>
